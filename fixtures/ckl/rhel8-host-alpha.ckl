					<VULN_ATTRIBUTE>STIG_UUID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21</ATTRIBUTE_DATA>
				</STIG_DATA>
