					<VULN_ATTRIBUTE>Rule_ID</VULN_ATTRIBUTE>
					<ATTRIBUTE_DATA>SV-230511r1130511_rule</ATTRIBUTE_DATA>
				</STIG_DATA>
				<STIG_DATA>
