          "group_tree": [
            {
              "id": "V-230237",
              "title": "The RHEL 8 pam_unix.so module must be configured in the password-auth file to use a FIPS 140-2 approved cryptographic hashing algorithm for system authentication.",
              "description": "<GroupDescription>Unapproved mechanisms that are used for authentication to the cryptographic module are not verified and therefore cannot be relied upon to provide confidentiality or integrity.</GroupDescription>"
            }
          ],
          "group_id": "V-230237",
          "severity": "medium",
          "group_title": "SRG-OS-000837-GPOS-00012",
          "rule_id_src": "SV-230237r1130237_rule",
          "rule_id": "SV-230237r1130237_rule",
          "rule_version": "RHEL-08-010160",
          "rule_title": "The RHEL 8 pam_unix.so module must be configured in the password-auth file to use a FIPS 140-2 approved cryptographic hashing algorithm for system authentication.",
          "fix_text": "Configure RHEL 8 to use a FIPS 140-2 approved cryptographic hashing algorithm for system authentication.\n\nEdit/modify the following line in the \"/etc/pam.d/password-auth\" file to include the sha512 option for pam_unix.so:\n\npassword sufficient pam_unix.so sha512 shadow try_first_pass use_authtok",
          "weight": "10.0",
          "check_content": "Verify that pam_unix.so module is configured to use sha512 with the following command:\n\n$ sudo grep password /etc/pam.d/password-auth | grep pam_unix\npassword sufficient pam_unix.so sha512 shadow try_first_pass use_authtok\n\nIf \"sha512\" is missing, or is commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Unapproved mechanisms that are used for authentication to the cryptographic module are not verified and therefore cannot be relied upon to provide confidentiality or integrity.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
