              "id": "V-230280",
              "title": "YUM must remove all software components after updated versions have been installed on RHEL 8.",
              "description": "<GroupDescription>Previous versions of software components that are not removed from the information system after updates have been installed may be exploited by adversaries.</GroupDescription>"
            }
          ],
          "group_id": "V-230280",
          "severity": "medium",
          "group_title": "SRG-OS-000880-GPOS-00022",
          "rule_id_src": "SV-230280r1130280_rule",
          "rule_id": "SV-230280r1130280_rule",
          "rule_version": "RHEL-08-010440",
          "rule_title": "YUM must remove all software components after updated versions have been installed on RHEL 8.",
          "fix_text": "Configure the operating system to remove all software components after updated versions have been installed.\n\nSet the \"clean_requirements_on_remove\" option to \"True\" in the \"/etc/dnf/dnf.conf\" file:\n\nclean_requirements_on_remove=True",
          "weight": "10.0",
          "check_content": "Verify the operating system removes all software components after updated versions have been installed.\n\nCheck if yum is configured to remove unneeded packages with the following command:\n\n$ sudo grep -i clean_requirements_on_remove /etc/dnf/dnf.conf\nclean_requirements_on_remove=True\n\nIf \"clean_requirements_on_remove\" is not set to \"True\", \"1\", or \"yes\", or is commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Previous versions of software components that are not removed from the information system after updates have been installed may be exploited by adversaries.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
