          "rule_version": "RHEL-08-030030",
          "rule_title": "The RHEL 8 audit log directory must be owned by root to prevent unauthorized read access.",
          "fix_text": "Configure the audit log directory to be owned by \"root\" with the following command:\n\n$ sudo chown root /var/log/audit",
          "weight": "10.0",
