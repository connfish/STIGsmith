          "group_tree": [
            {
              "id": "V-230468",
              "title": "RHEL 8 must generate audit records for any use of the \"su\" command.",
              "description": "<GroupDescription>Reconstruction of harmful events or forensic analysis is not possible if audit records do not contain enough information.</GroupDescription>"
            }
          ],
          "group_id": "V-230468",
          "severity": "medium",
          "group_title": "SRG-OS-000168-GPOS-00043",
          "rule_id_src": "SV-230468r1130468_rule",
          "rule_id": "SV-230468r1130468_rule",
          "rule_version": "RHEL-08-030310",
          "rule_title": "RHEL 8 must generate audit records for any use of the \"su\" command.",
          "fix_text": "Configure RHEL 8 to generate an audit record upon successful/unsuccessful attempts to use the \"su\" command.\n\nAdd or update the following rule to \"/etc/audit/rules.d/audit.rules\":\n\n-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k privileged-priv_change\n\nThe audit daemon must be restarted for the changes to take effect:\n\n$ sudo augenrules --load",
          "weight": "10.0",
          "check_content": "Verify RHEL 8 generates an audit record upon successful/unsuccessful attempts to use the \"su\" command with the following command:\n\n$ sudo grep -w \"/usr/bin/su\" /etc/audit/audit.rules\n-a always,exit -F path=/usr/bin/su -F perm=x -F auid>=1000 -F auid!=unset -k privileged-priv_change\n\nIf the command does not return a line, or the line is commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Reconstruction of harmful events or forensic analysis is not possible if audit records do not contain enough information.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
