        {
          "uuid": "d6bf35ce-8b0b-5133-ab90-dca8c4d7e74f",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230230",
          "group_tree": [
            {
              "id": "V-230230",
              "title": "RHEL 8, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
              "description": "<GroupDescription>Without path validation, an informed trust decision by the relying party cannot be made when presented with any certificate not already explicitly trusted.</GroupDescription>"
            }
          ],
          "group_id": "V-230230",
          "severity": "medium",
          "group_title": "SRG-OS-000830-GPOS-00008",
          "rule_id_src": "SV-230230r1130230_rule",
          "rule_id": "SV-230230r1130230_rule",
          "rule_version": "RHEL-08-010100",
          "rule_title": "RHEL 8, for PKI-based authentication, must validate certificates by constructing a certification path (which includes status information) to an accepted trust anchor.",
          "fix_text": "Configure RHEL 8, for PKI-based authentication, to validate certificates by constructing a certification path to an accepted trust anchor.\n\nObtain the DoD-approved certificate bundle and install it in \"/etc/sssd/pki/sssd_auth_ca_db.pem\".",
          "weight": "10.0",
          "check_content": "Verify RHEL 8 for PKI-based authentication has valid certificates by constructing a certification path to an accepted trust anchor.\n\nCheck that the system has a valid DoD root CA installed with the following command:\n\n$ sudo openssl x509 -text -in /etc/sssd/pki/sssd_auth_ca_db.pem\n\nIf the root ca file is not a DoD-approved trust anchor, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Without path validation, an informed trust decision by the relying party cannot be made when presented with any certificate not already explicitly trusted.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000830"
          ],
          "status": "open",
          "overrides": {},
          "comments": "Queued for remediation.",
          "finding_details": "Scanned by synthetic fixture generator. RHEL-08-010100 did not match the required value."
        },
        {
          "uuid": "e75b07dc-9ecb-5c20-8fc4-a35a201e4523",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230231",
          "group_tree": [
            {
              "id": "V-230231",
              "title": "RHEL 8 must encrypt all stored passwords with a FIPS 140-2 approved cryptographic hashing algorithm.",
              "description": "<GroupDescription>Passwords need to be protected at all times, and encryption is the standard method for protecting passwords.</GroupDescription>"
            }
          ],
          "group_id": "V-230231",
          "severity": "medium",
          "group_title": "SRG-OS-000831-GPOS-00009",
          "rule_id_src": "SV-230231r1130231_rule",
          "rule_id": "SV-230231r1130231_rule",
          "rule_version": "RHEL-08-010110",
          "rule_title": "RHEL 8 must encrypt all stored passwords with a FIPS 140-2 approved cryptographic hashing algorithm.",
          "fix_text": "Configure RHEL 8 to encrypt all stored passwords with a strong cryptographic hash.\n\nEdit/modify the following line in the \"/etc/libuser.conf\" file in the [defaults] section and set \"crypt_style\" to \"sha512\":\n\ncrypt_style = sha512",
          "weight": "10.0",
          "check_content": "Confirm that the interactive user account passwords are using a strong password hash with the following command:\n\n$ sudo grep -i crypt_style /etc/libuser.conf\ncrypt_style = sha512\n\nIf the \"crypt_style\" variable is not set to \"sha512\", is commented out, or does not exist, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Passwords need to be protected at all times, and encryption is the standard method for protecting passwords.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000831"
          ],
          "status": "not_a_finding",
          "overrides": {},
          "comments": "",
          "finding_details": "Scanned by synthetic fixture generator. RHEL-08-010110 matched the required value."
        },
        {
          "uuid": "fc222b08-b704-55ed-ae3a-8ff5bf99cb50",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230232",
          "group_tree": [
            {
              "id": "V-230232",
              "title": "RHEL 8 must employ FIPS 140-2 approved cryptographic hashing algorithms for all stored passwords.",
              "description": "<GroupDescription>The system must use a strong hashing algorithm to store the password.</GroupDescription>"
            }
          ],
          "group_id": "V-230232",
          "severity": "medium",
          "group_title": "SRG-OS-000832-GPOS-00010",
          "rule_id_src": "SV-230232r1130232_rule",
          "rule_id": "SV-230232r1130232_rule",
          "rule_version": "RHEL-08-010120",
          "rule_title": "RHEL 8 must employ FIPS 140-2 approved cryptographic hashing algorithms for all stored passwords.",
          "fix_text": "Lock all interactive user accounts not using SHA-512 hashing until the passwords can be regenerated with SHA-512.",
          "weight": "10.0",
          "check_content": "Verify that the shadow password suite configuration is set to encrypt password with a FIPS 140-2 approved cryptographic hashing algorithm.\n\nCheck the hashes of interactive user passwords with the following command:\n\n$ sudo cut -d: -f2 /etc/shadow\n$6$kcOnRq/5$NUEYPuyL.wghQwWssXRcLRFiiru7f5JPV6GaJhNC2aK5F3PZpE/BCCtwrxRc/AInKMNX3CdMw11m9STiql12f/\n\nIf any interactive user password hash does not begin with \"$6\", this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "The system must use a strong hashing algorithm to store the password.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [
            "SV-87232r792904_rule",
            "V-87232"
          ],
          "ccis": [
            "CCI-000832",
            "CCI-000366"
          ],
          "status": "open",
