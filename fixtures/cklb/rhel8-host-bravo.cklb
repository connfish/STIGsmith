            {
              "id": "V-230223",
              "title": "RHEL 8 must implement NIST FIPS-validated cryptography for the following: to provision digital signatures, to generate cryptographic hashes, and to protect data.",
              "description": "<GroupDescription>Use of weak or untested encryption algorithms undermines the purposes of using encryption to protect data.</GroupDescription>"
            }
          ],
          "group_id": "V-230223",
          "severity": "high",
          "group_title": "SRG-OS-000823-GPOS-00003",
          "rule_id_src": "SV-230223r1130223_rule",
          "rule_id": "SV-230223r1130223_rule",
          "rule_version": "RHEL-08-010020",
          "rule_title": "RHEL 8 must implement NIST FIPS-validated cryptography for the following: to provision digital signatures, to generate cryptographic hashes, and to protect data.",
          "fix_text": "Configure the operating system to implement FIPS mode with the following command:\n\n$ sudo fips-mode-setup --enable\n\nReboot the system for the change to take effect.",
          "weight": "10.0",
          "check_content": "Verify the operating system implements FIPS mode with the following command:\n\n$ sudo fips-mode-setup --check\nFIPS mode is enabled.\n\nIf FIPS mode is not enabled, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Use of weak or untested encryption algorithms undermines the purposes of using encryption to protect data.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
