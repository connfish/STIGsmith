        {
          "uuid": "90d007a7-174c-58c3-98e9-141f93bf6ae5",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230224",
          "group_tree": [
            {
              "id": "V-230224",
              "title": "All RHEL 8 local disk partitions must implement cryptographic mechanisms to prevent unauthorized disclosure or modification of all information that requires at rest protection.",
              "description": "<GroupDescription>Operating systems handling data requiring data at rest protections must employ cryptographic mechanisms to prevent unauthorized disclosure and modification of the information at rest.</GroupDescription>"
            }
          ],
          "group_id": "V-230224",
          "severity": "medium",
          "group_title": "SRG-OS-000824-GPOS-00004",
          "rule_id_src": "SV-230224r1130224_rule",
          "rule_id": "SV-230224r1130224_rule",
          "rule_version": "RHEL-08-010030",
          "rule_title": "All RHEL 8 local disk partitions must implement cryptographic mechanisms to prevent unauthorized disclosure or modification of all information that requires at rest protection.",
          "fix_text": "Configure RHEL 8 to prevent unauthorized modification of all information at rest by using disk encryption.\n\nEncrypting a partition in an already installed system is more difficult, because existing partitions will need to be resized and changed. To encrypt an entire partition, dedicate a partition for encryption in the partition layout.",
          "weight": "10.0",
          "check_content": "Verify RHEL 8 prevents unauthorized disclosure or modification of all information requiring at rest protection by using disk encryption.\n\nIf there is a documented and approved reason for not having data-at-rest encryption, this requirement is Not Applicable.\n\nDetermine the partition layout with the following command:\n\n$ sudo blkid\n\nIf partitions containing information requiring at rest protection are not encrypted, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Operating systems handling data requiring data at rest protections must employ cryptographic mechanisms to prevent unauthorized disclosure and modification of the information at rest.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [
            "SV-87224r792904_rule",
            "V-87224"
          ],
          "ccis": [
            "CCI-000824"
          ],
          "status": "open",
          "overrides": {},
          "comments": "Queued for remediation.",
          "finding_details": "Scanned by synthetic fixture generator. RHEL-08-010030 did not match the required value."
        },
        {
          "uuid": "3ca5e344-8a86-55be-8aa0-a65eae90ff40",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230225",
          "group_tree": [
            {
              "id": "V-230225",
              "title": "RHEL 8 must display the Standard Mandatory DoD Notice and Consent Banner before granting local or remote access to the system via a ssh logon.",
              "description": "<GroupDescription>Display of a standardized and approved use notification before granting access to the operating system ensures privacy and security notification verbiage used is consistent with applicable federal laws.</GroupDescription>"
            }
          ],
          "group_id": "V-230225",
          "severity": "medium",
          "group_title": "SRG-OS-000825-GPOS-00005",
          "rule_id_src": "SV-230225r1130225_rule",
          "rule_id": "SV-230225r1130225_rule",
          "rule_version": "RHEL-08-010040",
          "rule_title": "RHEL 8 must display the Standard Mandatory DoD Notice and Consent Banner before granting local or remote access to the system via a ssh logon.",
          "fix_text": "Configure RHEL 8 to display the Standard Mandatory DoD Notice and Consent Banner before granting access to the system via SSH.\n\nEdit the \"/etc/ssh/sshd_config\" file to uncomment the banner keyword and configure it to point to a file that will contain the logon banner:\n\nBanner /etc/issue\n\nThe SSH service must be restarted for changes to take effect.",
          "weight": "10.0",
          "check_content": "Verify any publicly accessible connection to the operating system displays the Standard Mandatory DoD Notice and Consent Banner before granting access.\n\nCheck for the location of the banner file being used with the following command:\n\n$ sudo grep -ir banner /etc/ssh/sshd_config\nbanner /etc/issue\n\nIf the line is commented out or missing, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Display of a standardized and approved use notification before granting access to the operating system ensures privacy and security notification verbiage used is consistent with applicable federal laws.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000825"
          ],
          "status": "not_applicable",
          "overrides": {},
          "comments": "",
          "finding_details": "Not applicable to this platform configuration."
        },
        {
          "uuid": "f7180193-a044-5027-b1be-0343ea017f82",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230227",
          "group_tree": [
            {
              "id": "V-230227",
              "title": "RHEL 8 must display the Standard Mandatory DoD Notice and Consent Banner before granting local or remote access to the system via a graphical user logon.",
              "description": "<GroupDescription>The banner must be acknowledged by the user prior to allowing the user access to the operating system.</GroupDescription>"
            }
          ],
          "group_id": "V-230227",
          "severity": "medium",
          "group_title": "SRG-OS-000827-GPOS-00006",
          "rule_id_src": "SV-230227r1130227_rule",
          "rule_id": "SV-230227r1130227_rule",
          "rule_version": "RHEL-08-010060",
          "rule_title": "RHEL 8 must display the Standard Mandatory DoD Notice and Consent Banner before granting local or remote access to the system via a graphical user logon.",
          "fix_text": "Configure the operating system to display the Standard Mandatory DoD Notice and Consent Banner before granting access to the system.\n\nCreate a database to contain the system-wide graphical user logon settings (if it does not already exist) with the following command:\n\n$ sudo touch /etc/dconf/db/local.d/01-banner-message\n\nAdd the following line to the [org/gnome/login-screen] section:\n\nbanner-message-enable=true\n\nRun the following command to update the database:\n\n$ sudo dconf update",
          "weight": "10.0",
          "check_content": "Verify RHEL 8 displays the Standard Mandatory DoD Notice and Consent Banner before granting access to the operating system via a graphical user logon.\n\nNote: This requirement assumes the use of the RHEL 8 default graphical user interface, Gnome Shell. If the system does not have any graphical user interface installed, this requirement is Not Applicable.\n\nCheck that the operating system displays the exact Standard Mandatory DoD Notice and Consent Banner text with the command:\n\n$ sudo grep banner-message-text /etc/dconf/db/local.d/*\n\nIf the banner does not match the Standard Mandatory DoD Notice and Consent Banner exactly, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "The banner must be acknowledged by the user prior to allowing the user access to the operating system.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000827"
          ],
          "status": "open",
          "overrides": {},
          "comments": "Queued for remediation.",
