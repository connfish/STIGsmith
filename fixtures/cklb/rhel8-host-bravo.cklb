            {
              "id": "V-230271",
              "title": "RHEL 8 must enable kernel parameters to enforce discretionary access control on symlinks.",
              "description": "<GroupDescription>By enabling the fs.protected_symlinks kernel parameter, symbolic links are permitted to be followed only when outside a sticky world-writable directory.</GroupDescription>"
            }
          ],
          "group_id": "V-230271",
          "severity": "medium",
          "group_title": "SRG-OS-000871-GPOS-00021",
          "rule_id_src": "SV-230271r1130271_rule",
          "rule_id": "SV-230271r1130271_rule",
          "rule_version": "RHEL-08-010372",
          "rule_title": "RHEL 8 must enable kernel parameters to enforce discretionary access control on symlinks.",
          "fix_text": "Configure the operating system to enable DAC on symlinks with the following command:\n\nAdd or edit the following line in a system configuration file in the \"/etc/sysctl.d/\" directory:\n\nfs.protected_symlinks = 1\n\nLoad settings from all system configuration files with the following command:\n\n$ sudo sysctl --system",
          "weight": "10.0",
          "check_content": "Verify the operating system is configured to enable DAC on symlinks with the following command:\n\n$ sudo sysctl fs.protected_symlinks\nfs.protected_symlinks = 1\n\nIf \"fs.protected_symlinks\" is not set to \"1\" or is missing, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "By enabling the fs.protected_symlinks kernel parameter, symbolic links are permitted to be followed only when outside a sticky world-writable directory.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
