              "id": "V-230332",
              "title": "RHEL 8 must automatically lock an account when three unsuccessful logon attempts occur.",
              "description": "<GroupDescription>By limiting the number of failed logon attempts, the risk of unauthorized system access via user password guessing, otherwise known as brute-force attacks, is reduced.</GroupDescription>"
            }
          ],
          "group_id": "V-230332",
          "severity": "medium",
          "group_title": "SRG-OS-000932-GPOS-00028",
          "rule_id_src": "SV-230332r1130332_rule",
          "rule_id": "SV-230332r1130332_rule",
          "rule_version": "RHEL-08-020010",
          "rule_title": "RHEL 8 must automatically lock an account when three unsuccessful logon attempts occur.",
          "fix_text": "Configure the operating system to lock an account when three unsuccessful logon attempts occur.\n\nAdd/Modify the \"/etc/security/faillock.conf\" file to match the following line:\n\ndeny = 3",
          "weight": "10.0",
          "check_content": "Check that the system locks an account after three unsuccessful logon attempts with the following commands:\n\n$ sudo grep 'deny =' /etc/security/faillock.conf\ndeny = 3\n\nIf the \"deny\" option is not set to \"3\" or less (but not \"0\"), is missing or commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "By limiting the number of failed logon attempts, the risk of unauthorized system access via user password guessing, otherwise known as brute-force attacks, is reduced.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
