          "group_tree": [
            {
              "id": "V-230251",
              "title": "The RHEL 8 SSH server must be configured to use only Message Authentication Codes (MACs) employing FIPS 140-2 validated cryptographic hash algorithms.",
              "description": "<GroupDescription>Without cryptographic integrity protections, information can be altered by unauthorized users without detection.</GroupDescription>"
            }
          ],
          "group_id": "V-230251",
          "severity": "medium",
          "group_title": "SRG-OS-000851-GPOS-00015",
          "rule_id_src": "SV-230251r1130251_rule",
          "rule_id": "SV-230251r1130251_rule",
          "rule_version": "RHEL-08-010290",
          "rule_title": "The RHEL 8 SSH server must be configured to use only Message Authentication Codes (MACs) employing FIPS 140-2 validated cryptographic hash algorithms.",
          "fix_text": "Configure the RHEL 8 SSH server to use only MACs employing FIPS 140-2-approved algorithms.\n\nUpdate the \"/etc/crypto-policies/back-ends/openssh.config\" file to include these MACs employing FIPS 140-2-approved algorithms:\n\nMACs hmac-sha2-512,hmac-sha2-256\n\nA reboot is required for the changes to take effect.",
          "weight": "10.0",
          "check_content": "Verify the SSH server is configured to use only MACs employing FIPS 140-2-approved algorithms with the following command:\n\n$ sudo grep -i macs /etc/crypto-policies/back-ends/openssh.config\nMACs hmac-sha2-512,hmac-sha2-256\n\nIf the MACs entries in the \"openssh.config\" file have any hashes other than \"hmac-sha2-512\" and \"hmac-sha2-256\", the order differs from the example above, or they are missing or commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Without cryptographic integrity protections, information can be altered by unauthorized users without detection.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
