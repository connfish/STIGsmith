            {
              "id": "V-230375",
              "title": "RHEL 8 must be configured in the password-auth file to prohibit password reuse for a minimum of five generations.",
              "description": "<GroupDescription>Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks.</GroupDescription>"
            }
          ],
          "group_id": "V-230375",
          "severity": "medium",
          "group_title": "SRG-OS-000975-GPOS-00036",
          "rule_id_src": "SV-230375r1130375_rule",
          "rule_id": "SV-230375r1130375_rule",
          "rule_version": "RHEL-08-020250",
          "rule_title": "RHEL 8 must be configured in the password-auth file to prohibit password reuse for a minimum of five generations.",
          "fix_text": "Configure the operating system to prohibit password reuse for a minimum of five generations.\n\nAdd the following line in \"/etc/pam.d/password-auth\":\n\npassword required pam_pwhistory.so use_authtok remember=5 retry=3",
          "weight": "10.0",
          "check_content": "Verify the operating system prohibits password reuse for a minimum of five generations:\n\n$ sudo grep -i remember /etc/pam.d/password-auth\npassword required pam_pwhistory.so use_authtok remember=5 retry=3\n\nIf the \"remember\" parameter value is not greater than or equal to \"5\", is commented out, or is missing, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Password complexity, or strength, is a measure of the effectiveness of a password in resisting attempts at guessing and brute-force attacks.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
