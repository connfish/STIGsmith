          "group_tree": [
            {
              "id": "V-230511",
              "title": "A RHEL 8 firewall must employ a deny-all, allow-by-exception policy for allowing connections to other systems.",
              "description": "<GroupDescription>Failure to restrict network connectivity only to authorized systems permits inbound connections from malicious systems.</GroupDescription>"
            }
          ],
          "group_id": "V-230511",
          "severity": "medium",
          "group_title": "SRG-OS-000211-GPOS-00051",
          "rule_id_src": "SV-230511r1130511_rule",
          "rule_id": "SV-230511r1130511_rule",
          "rule_version": "RHEL-08-040090",
          "rule_title": "A RHEL 8 firewall must employ a deny-all, allow-by-exception policy for allowing connections to other systems.",
          "fix_text": "Configure the \"firewalld\" daemon to employ a deny-all, allow-by-exception policy.\n\nSet the zone target to DROP and add only the ports and services identified in the PPSM CLSA:\n\n$ sudo firewall-cmd --permanent --zone=public --set-target=DROP\n$ sudo firewall-cmd --reload",
          "weight": "10.0",
          "check_content": "Verify the firewall is configured to employ a deny-all, allow-by-exception policy for allowing connections to other systems with the following commands:\n\n$ sudo firewall-cmd --state\nrunning\n\n$ sudo firewall-cmd --get-active-zones\npublic\n  interfaces: ens33\n\n$ sudo firewall-cmd --info-zone=public | grep target\n  target: DROP\n\nAsk the System Administrator for the site or program Ports, Protocols, and Services Management Component Local Service Assessment (PPSM CLSA). Verify the services allowed by the firewall match the PPSM CLSA.\n\nIf the firewall is not configured to employ a deny-all, allow-by-exception policy, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Failure to restrict network connectivity only to authorized systems permits inbound connections from malicious systems.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
