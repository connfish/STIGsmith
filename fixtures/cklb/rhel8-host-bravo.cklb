        {
          "uuid": "2b0994ab-d969-5e96-a0f6-077dfd6a3d6b",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230331",
          "group_tree": [
            {
              "id": "V-230331",
              "title": "RHEL 8 must automatically lock an account until the locked account is released by an administrator when three unsuccessful logon attempts occur during a 15-minute time period.",
              "description": "<GroupDescription>By limiting the number of failed logon attempts, the risk of unauthorized system access via user password guessing is reduced.</GroupDescription>"
            }
          ],
          "group_id": "V-230331",
          "severity": "medium",
          "group_title": "SRG-OS-000931-GPOS-00068",
          "rule_id_src": "SV-230331r1130331_rule",
          "rule_id": "SV-230331r1130331_rule",
          "rule_version": "RHEL-08-020009",
          "rule_title": "RHEL 8 must automatically lock an account until the locked account is released by an administrator when three unsuccessful logon attempts occur during a 15-minute time period.",
          "fix_text": "Configure the operating system to lock an account until released by an administrator when three unsuccessful logon attempts occur in 15 minutes.\n\nAdd/Modify the \"/etc/security/faillock.conf\" file to match the following line:\n\nunlock_time = 0\n\nNote: If a centralized account management method is in use, apply the equivalent setting there instead; the local file will not be authoritative.",
          "weight": "10.0",
          "check_content": "Note: If the system administrator (SA) demonstrates the use of an approved centralized account management method that locks an account after three unsuccessful logon attempts within a period of 15 minutes, this requirement is Not Applicable.\n\nCheck that the system locks an account after three unsuccessful logon attempts within a period of 15 minutes with the following commands:\n\n$ sudo grep 'unlock_time =' /etc/security/faillock.conf\nunlock_time = 0\n\nIf the \"unlock_time\" option is not set to \"0\", is missing or commented out, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "By limiting the number of failed logon attempts, the risk of unauthorized system access via user password guessing is reduced.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000931",
            "CCI-000366"
          ],
          "status": "open",
          "overrides": {},
          "comments": "Queued for remediation.",
          "finding_details": "Scanned by synthetic fixture generator. RHEL-08-020009 did not match the required value."
        },
        {
          "uuid": "41cdc0d6-d082-5196-bad1-179220c24dbc",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230378",
          "group_tree": [
            {
              "id": "V-230378",
              "title": "All RHEL 8 local interactive user accounts must be assigned a home directory upon creation.",
              "description": "<GroupDescription>If local interactive users are not assigned a valid home directory, there is no place for the storage and control of files they should own.</GroupDescription>"
            }
          ],
          "group_id": "V-230378",
          "severity": "medium",
          "group_title": "SRG-OS-000978-GPOS-00069",
          "rule_id_src": "SV-230378r1130378_rule",
          "rule_id": "SV-230378r1130378_rule",
          "rule_version": "RHEL-08-020280",
          "rule_title": "All RHEL 8 local interactive user accounts must be assigned a home directory upon creation.",
          "fix_text": "Configure RHEL 8 to assign home directories to all new local interactive users by setting the \"CREATE_HOME\" parameter in \"/etc/login.defs\" to \"yes\":\n\nCREATE_HOME yes\n\nIf home directories are provisioned by a directory service, configure the equivalent setting there instead.",
          "weight": "10.0",
          "check_content": "Verify all local interactive users on RHEL 8 are assigned a home directory upon creation with the following command:\n\n$ sudo grep -i create_home /etc/login.defs\nCREATE_HOME yes\n\nIf the value for \"CREATE_HOME\" parameter is not set to \"yes\", the line is missing, or the line is commented out, this is a finding.\n\nNote: If the site uses a directory service that provisions home directories on a fileserver, determine with the System Administrator whether CREATE_HOME is the correct control point for this system.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "If local interactive users are not assigned a valid home directory, there is no place for the storage and control of files they should own.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000978"
          ],
          "status": "not_applicable",
          "overrides": {},
          "comments": "",
          "finding_details": "Not applicable to this platform configuration."
        },
        {
          "uuid": "bd258929-f4d7-5499-aa21-5dcdd6303d9f",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230399",
          "group_tree": [
            {
              "id": "V-230399",
              "title": "RHEL 8 audit logs must have a mode of 0600 or less permissive to prevent unauthorized read access.",
              "description": "<GroupDescription>Unauthorized disclosure of audit records can reveal system and configuration data to attackers.</GroupDescription>"
            }
          ],
          "group_id": "V-230399",
          "severity": "medium",
          "group_title": "SRG-OS-000999-GPOS-00070",
          "rule_id_src": "SV-230399r1130399_rule",
          "rule_id": "SV-230399r1130399_rule",
          "rule_version": "RHEL-08-030070",
          "rule_title": "RHEL 8 audit logs must have a mode of 0600 or less permissive to prevent unauthorized read access.",
          "fix_text": "Configure the audit logs to be protected from unauthorized read access by setting the correct permissive mode with the following command, substituting the audit log path from \"auditd.conf\":\n\n$ sudo chmod 0600 /var/log/audit/*",
          "weight": "10.0",
          "check_content": "Verify the audit logs have a mode of \"0600\" or less permissive.\n\nFirst determine where the audit logs are stored with the following command:\n\n$ sudo grep -iw log_file /etc/audit/auditd.conf\nlog_file = /var/log/audit/audit.log\n\nUsing the location of the audit log file, check if each audit log has a mode of \"0600\" or less permissive with the following command, substituting the correct audit log path:\n\n$ sudo stat -c \"%a %n\" /var/log/audit/*\n600 /var/log/audit/audit.log\n\nIf the audit logs have a mode more permissive than \"0600\", this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Unauthorized disclosure of audit records can reveal system and configuration data to attackers.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
          "legacy_ids": [],
          "ccis": [
            "CCI-000999"
          ],
          "status": "open",
          "overrides": {},
          "comments": "Queued for remediation.",
          "finding_details": "Scanned by synthetic fixture generator. RHEL-08-030070 did not match the required value."
        },
        {
          "uuid": "1da95896-587b-579f-9599-24c3d43b71ab",
          "stig_uuid": "8f0c2a64-5d7e-4a1b-9c3f-0e6d5b4a3c21",
          "target_key": null,
          "stig_ref": null,
          "group_id_src": "V-230505",
          "group_tree": [
            {
              "id": "V-230505",
              "title": "The RHEL 8 file system automounter must be disabled unless required.",
              "description": "<GroupDescription>Automatically mounting file systems permits easy introduction of unknown devices, thereby facilitating malicious activity.</GroupDescription>"
            }
          ],
          "group_id": "V-230505",
          "severity": "medium",
          "group_title": "SRG-OS-000205-GPOS-00071",
          "rule_id_src": "SV-230505r1130505_rule",
          "rule_id": "SV-230505r1130505_rule",
          "rule_version": "RHEL-08-040023",
          "rule_title": "The RHEL 8 file system automounter must be disabled unless required.",
          "fix_text": "Configure the operating system to disable the ability to automount devices.\n\nIf autofs is not required for the mission:\n\n$ sudo systemctl mask --now autofs\n\nIf autofs is required, document the requirement and obtain ISSO approval instead of disabling it.",
          "weight": "10.0",
          "check_content": "Verify the operating system disables the ability to automount devices.\n\nNote: If the autofs service is required for the system's documented mission, and its use is approved by the Information System Security Officer (ISSO), this requirement is Not Applicable.\n\nCheck that the autofs service is disabled with the following command:\n\n$ sudo systemctl is-enabled autofs\ndisabled\n\nIf the autofs service is enabled and is not documented as an operational requirement, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Automatically mounting file systems permits easy introduction of unknown devices, thereby facilitating malicious activity.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "mitigation_control": "",
          "responsibility": "",
          "ia_controls": "",
