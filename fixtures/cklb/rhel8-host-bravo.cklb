            {
              "id": "V-230346",
              "title": "RHEL 8 must limit the number of concurrent sessions to ten for all accounts and/or account types.",
              "description": "<GroupDescription>Operating system management includes the ability to control the number of users and user sessions that utilize an operating system.</GroupDescription>"
            }
          ],
          "group_id": "V-230346",
          "severity": "medium",
          "group_title": "SRG-OS-000946-GPOS-00029",
          "rule_id_src": "SV-230346r1130346_rule",
          "rule_id": "SV-230346r1130346_rule",
          "rule_version": "RHEL-08-020024",
          "rule_title": "RHEL 8 must limit the number of concurrent sessions to ten for all accounts and/or account types.",
          "fix_text": "Configure the operating system to limit the number of concurrent sessions to ten for all accounts and/or account types.\n\nAdd the following line to the top of the /etc/security/limits.conf or in a \".conf\" file defined in /etc/security/limits.d/:\n\n* hard maxlogins 10",
          "weight": "10.0",
          "check_content": "Verify the operating system limits the number of concurrent sessions to \"10\" for all accounts and/or account types with the following command:\n\n$ sudo grep -r maxlogins /etc/security/limits.conf /etc/security/limits.d/*.conf\n* hard maxlogins 10\n\nIf the \"maxlogins\" item is missing or the value is not set to 10 or less, this is a finding.",
          "check_content_ref": {
            "href": "",
            "name": "M"
          },
          "classification": "Unclass",
          "discussion": "Operating system management includes the ability to control the number of users and user sessions that utilize an operating system.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": false,
          "security_override_guidance": "",
          "mitigations": "",
